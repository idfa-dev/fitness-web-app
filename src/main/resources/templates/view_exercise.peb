{% extends "base.peb" %}

{% block title %}Exercises{% endblock %}

{% block header %}

{%  if exercise is empty %}
    <div class="center">
        <h2> Exercise not found </h2>
    </div>
{% else %}
    {% if exercise['type'] == 0 %}
        <div class="center">
            <h2 style="color:red;">
                {{ exercise['name'] }}
            </h2>
        </div>
    {% elseif exercise['type'] == 1 %}
        <div class="center">
            <h2 style="color:lightskyblue;">
                {{ exercise['name'] }}
            </h2>
        </div>
    {% elseif exercise['type'] == 2 %}
        <div class="center">
            <h2 style="color:green;">
                {{ exercise['name'] }}
            </h2>
        </div>
    {% elseif exercise['type'] == 3 %}
        <div class="center">
            <h2 style="color:yellow;">
                {{ exercise['name'] }}
            </h2>
        </div>
    {% endif %}
{% endif %}
{% endblock %}
{% block content %}
