{% extends "base.peb" %}

{% block title %}Exercises{% endblock %}

{% block header %}
<h2 style="color:red; position:absolute; left:50%; transform:translateX(-50%);">
    Cardio 1
</h2>
{% endblock %}

{% block content %}

<video width="320" height="240" autoplay muted>
  <source src="videos/cable_row.mp4" type="video/mp4">
  Your browser does not support the video tag.
</video>

<a href="/exercises" class="back-link">
    Back to Exercise List
</a>

{% endblock %}

<div>
<style>
.back-link {
    display: block;
    text-align: center;
    margin: 20px auto;  
    text-decoration: none;
    color: #b73fec;
    font-weight: bold;
    font-size: 1.2em;
}

.back-link:hover {
    color: #8a2be2; 
    cursor: pointer;
}
</style>