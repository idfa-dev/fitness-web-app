<link rel="stylesheet" href="/static/stylesheet.css">

<title>Sign In</title>

<div class="landing-bg">

    <img class="bg-img" src="/static/images/landing_background.png" alt="background">

    <div class="landing-box" style="max-width: 400px; margin: auto;">

        <div style="text-align: center;">
            <img src="/static/images/jympal_logo.png" alt="Jympal logo" style="width: 50%; margin-top: 10px;">
            <br>
            <img class="mini-running" src="/static/images/running.png" alt="running">
            <br>
            <h1 class="purple-rect">SIGN IN</h1>
        </div>

        <div class="landing-text">

            <form action="/sign-in" method="post">

                <div class="input-group">
                    <input type="text" name="username" placeholder="Username" required>
                </div>

                <div class="input-group">
                    <input type="password" name="password" placeholder="Password" required>
                </div>

                <button class="pill-btn" type="submit" style="display: block; margin: 40px auto 0;">
                    SIGN IN
                </button>
            </form>

            <p style="text-align: center; margin-top: 30px;">
                Don't have an account?
                <a href="/sign-up" style="color: #9933FF;">Sign Up</a>
            </p>

        </div>

    </div>
</div>
