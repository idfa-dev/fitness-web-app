<link rel="stylesheet" href="/static/stylesheet.css">

<title> Jympal Home </title>

<div class="landing-bg">

    <img class="bg-img" src="/static/images/landing_background.png" alt="background">

    <div class="landing-box">

        <div style="text-align: left">
            <img src="/static/images/jympal_logo.png" alt="Jympal logo" style="width: 15%; margin-top:7px%;">
        </div>

        <div style="text-align: left">
            <div class="landing-slogan">
                You wanna be fit? Jymit!
            </div>
        </div>

        {% block action %}
        {% endblock %}

        {% block content %}

        <div style="display: flex; gap: 20px;">

            <div style="flex: 55; text-align: left; margin-top: -10px;">
                <div class="landing-text">
                    <h3 class="purple-rect">About Jympal</h3>
                    <p>
                    Jympal is a fitness tracking platform designed to help your training be consistent!
                    </p>

                    <h3 class="purple-rect">Features For All Accounts</h3>
                    <ul>
                        <li>Track distance, reps, sets, and calories per exercise</li>
                        <li>Create workouts, categorised into Cardio, Body Weight, Resistance, and Mixed</li>
                        <li>Log and view completed exercises on a calendar</li>
                        <li>Options for personal, competitor, or personal trainer accounts</li>
                    </ul>

                    <h3 class="purple-rect">Competitor Account Features</h3>
                    <ul>
                        <li>Log upcoming competitions to the calendar</li>
                        <li>Add completion times to competitions to track personal bests</li>
                    </ul>

                    <h3 class="purple-rect">Personal Trainer Account Features</h3>
                    <ul>
                        <li>Add clients and oversee their activity</li>
                    </ul>

                    <h3 class="purple-rect">Get Started</h3>
                    <p>
                        Sign in or create an account to take control of your training today!
                    </p> 

                    <div style="margin-top:15px;">
                        <a href="/sign-in" class="pill-btn">SIGN IN</a>

                        <a href="/sign-up" class="pill-btn">SIGN UP</a>
                    </div>

                </div>
            </div>

            <div style="flex: 45; text-align: center;">
                <img src="/static/images/running.png" alt="Landing image" style="height: 40vw; width: 40vw; border-radius: 15px; margin-top: -85px; margin-right: 5px;">
            </div>

        </div>

        {% endblock %}

    </div>
</div>
