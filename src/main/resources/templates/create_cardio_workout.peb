{% extends "base.peb" %}

{% block title %}Create a cardio workout{% endblock %}

{% block header %}
<div class="center">
    <h1 style="margin-top:0px;margin-bottom:0px;">CARDIO EXERCISES</h1>
</div>
<div class="center">
    <form class="search-container" action=#>
        <input type="text" class="search" placeholder="Search for an exercise...">
            <button type="submit" class="btn-reset search-btn">
                <img src="/static/images/magnifying_glass_icon.png" alt="submit">
            </button>
    </form>
</div>
<div class="center" style="width: 90%;">
    <form action=#">
        <label class="selection-container">
            Exercise A
            <input type="checkbox">
            <span class="checkmark"></span>
        </label>
        <label class="selection-container">
            Exercise B
            <input type="checkbox">
            <span class="checkmark"></span>
        </label>
        <label class="selection-container">
            Exercise C
            <input type="checkbox">
            <span class="checkmark"></span>
        </label>
        <label class="selection-container">
            Exercise D
            <input type="checkbox">
            <span class="checkmark"></span>
        </label>
        <label class="selection-container">
            Exercise E
            <input type="checkbox">
            <span class="checkmark"></span>
        </label>
        <label class="selection-container">
            Exercise F
            <input type="checkbox">
            <span class="checkmark"></span>
        </label>
        <button type=submit style="margin-top: 20px;">Create</button>
    </form>
</div>
{% endblock %}