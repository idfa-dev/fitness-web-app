{% extends "base.peb" %}

{% block title %}Calendar{% endblock %}

{% block header %}{% endblock %}

{% block content %}
<div class="calendar-container">
    <div class="month-nav">
        <button id="prev-month">&lt;</button>

        <div class="month-year">{{ month }} {{ year }}</div>

        <button id="next-month">&gt;</button>
    </div>

    <div class="add-event-text">Add<br>Event</div>
    <button id="plus-btn">+</button>
    {{ calendarTable | raw }}

    <div id="popup-overlay">
        <div id="popup">
            <div id="popup-selection">
                <button id="add-comp-btn" class="popup-type-btn">Add Competition</button>
                <button id="add-ex-btn" class="popup-type-btn">Add Exercise</button>
            </div>

            <div id="competition-form">
                <div class="form-title">Add Competition</div>
                <input type="hidden" id="comp-id">
                <div class ="required-field">
                    <input type="text" id="comp-name" placeholder="Competition Name">
                    <span class="required-star">*</span>
                </div>
                <div class ="required-field">
                    <input type="date" id="comp-date">
                    <span class="required-star">*</span>
                </div>
                <div class ="required-field">
                    <input type="time" id="comp-time">
                    <span class="required-star">*</span>
                </div>
                <div class ="required-field">
                    <input type="text" id="comp-distance" placeholder="Distance (km)" min="0">
                    <span class="required-star">*</span>
                </div>
                <input type="text" id="comp-finish-time" placeholder="Time Taken (hh:mm:ss)">
                <div id="competition-types">
                    <div class="comp-type">
                        <div class="circle" data-color="#E32141" data-name="Running"></div>
                        <div class="type-label">Running</div>
                    </div>
                    <div class="comp-type">
                        <div class="circle" data-color="#0F95CB" data-name="Swimming"></div>
                        <div class="type-label">Swimming</div>
                    </div>
                    <div class="comp-type">
                        <div class="circle" data-color="#196B24" data-name="Cycling"></div>
                        <div class="type-label">Cycling</div>
                    </div>
                </div>
                <button id="submit-competition">Submit</button>
            </div>

            <div id="exercise-form">
                <div class="form-title">Add Exercise</div>
                <div class ="required-field">
                    <input type="text" id="ex-name" placeholder="Exercise Name">
                    <span class="required-star">*</span>
                </div>
                <div class ="required-field">
                    <input type="date" id="ex-date">
                    <span class="required-star">*</span>
                </div>
                <div class="required-field">
                    <input type="text" id="ex-time-taken" placeholder="Time Taken (hh:mm:ss)">
                    <span class="required-star">*</span>
                </div>

                <div class="required-field">
                    <input type="text" id="ex-calories" placeholder="Calories Burnt (kcal)">
                    <span class="required-star">*</span>
                </div>

                <div class="side-by-side">
                    <input type="text" id="ex-distance" placeholder="Distance (km)" min="0">
                    <input type="text" id="ex-machine" placeholder="Machine">
                </div>
                <div class="side-by-side">
                    <input type="text" id="ex-weight" placeholder="Weight (kg)" min="0">
                    <input type="text" id="ex-sets-reps" placeholder="Sets x Reps (e.g. 3x10)">
                </div>
                <div id="exercise-types">
                    <div class="ex-type">
                        <div class="circle" data-color="#E32141"></div>
                        <div class="type-label">Cardio</div>
                    </div>
                    <div class="ex-type">
                        <div class="circle" data-color="#0F95CB"></div>
                        <div class="type-label">Body Weight</div>
                    </div>
                    <div class="ex-type">
                        <div class="circle" data-color="#196B24"></div>
                        <div class="type-label">Resistance</div>
                    </div>
                    <div class="ex-type">
                        <div class="circle" data-color="#FFC000"></div>
                        <div class="type-label">Mixed</div>
                    </div>
                </div>
                <button id="submit-exercise">Submit</button>
            </div>
        </div>
    </div>

    <div id="comp-info-overlay">
        <div id="comp-info-popup">
            <div id="comp-info-content">
                <div id="exercise-list-view"></div>
                <div id="exercise-detail-view" style="display:none;"></div>
            </div>
            <div id="comp-action-buttons" style="display:flex; gap:10px;">
                <button id="edit-event-btn">Update</button>
                <button id="delete-event-btn">Delete</button>
            </div>
        </div>
    </div>
</div>

<style>
html, body {
    margin:0;
    padding:0;
    height:100%;
    font-family:"Arial", sans-serif;
    color:white;
}

.page-title-container {
    display:none;
}

.calendar-container {
    width:100%;
    position:relative;
    padding-bottom:0.5rem;
    padding-top:-2rem;
}

.month-year {
    font-size:6vh;
    font-weight:bold;
    margin-top:-0.5;
    line-height:1;
}

.add-event-text {
    position:absolute;
    top:0.6rem;
    right: calc(1rem + 4rem + 10px);
    text-align:center;
    font-size:1.5rem;
    line-height:1.4rem;
    color:white;
    cursor:default;
}

#plus-btn {
    position:absolute;
    top:-0.1rem;
    right:1rem;
    width:4rem;
    height:4rem;
    font-size:2rem;
    border-radius:50%;
    border:2px solid black;
    background:white;
    color:black;
    cursor:pointer;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 0.6rem;
}

#plus-btn:hover {
    background:#131313;
    color:white;
    border:2px solid white;
}

table.calendar {
    border-collapse:collapse;
    width:84vw;
    text-align:center;
    margin:2.3rem 3rem 0 -1rem;
}

table.calendar th, table.calendar td {
    border:1px solid white;
    padding:0.5rem;
    height:4.7rem;
    width:calc(80vw / 7);
    position:relative;
}

table.calendar th {
    text-transform:uppercase;
    font-weight:bold;
    font-size:2rem;
}

table.calendar td {
    vertical-align:top;
    color:white;
    font-size:1.5rem;
}

.day-number {
    position:absolute;
    top:0.2rem;
    right:0.2rem;
}

.comp-pill {
    position: absolute;
    top: 0.2rem;
    left: 0.2rem;
    background-color: #f33e7a;
    color: white;
    padding: 4px 9px;
    border-radius: 12px;
    font-size: 1rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: calc(100% - 3.5rem);
    cursor: pointer;
}

.exercise-dot {
    position: absolute;
    bottom: 0.2rem;
    width: 20px;
    height: 20px;
    border-radius: 12px;
    cursor: pointer;
}

.exercise-dot.red {
    right: 5.0rem;
    background:#E32141;
}

.exercise-dot.blue {
    right: 3.4rem;
    background:#0F95CB;
}

.exercise-dot.green {
    right: 1.8rem;
    background:#196B24;
}

.exercise-dot.yellow {
    right: 0.2rem;
    background:#FFC000;
}

#popup-overlay, #comp-info-overlay {
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:100%;
    display:none;
    justify-content:center;
    align-items:center;
    background:rgba(0,0,0,0.4);
    z-index:1000;
}

#popup {
    width:60vw;
    max-width:600px;
    height:60vh;
    background:#131313;
    border:2px solid white;
    border-radius:25px;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:20px;
    padding:20px;
    overflow-y:auto;
}

#popup-selection {
    display:flex;
    gap:30px;
    justify-content:center;
    margin-top:32%;
    transition: all 0.3s;
}

.popup-type-btn {
    background:#9933FF;
    color:white;
    border:none;
    border-radius:20px;
    padding:30px 60px;
    cursor:pointer;
    font-size:22px;
    min-width:200px;
    min-height:80px;
    transition: all 0.3s;
}

#popup-selection.top {
    margin-top:10px;
    justify-content:center;
}

#popup-selection.top .popup-type-btn {
    padding:15px 35px;
    font-size:16px;
    min-width:120px;
    min-height:50px;
}

#competition-form, #exercise-form {
    display:none;
    width:100%;
}

.form-title {
    font-size:1.5rem;
    font-weight:bold;
    margin-bottom:10px;
    text-align:center;
}

.side-by-side {
    display:flex;
    gap:10px;
}

#exercise-types, #competition-types {
    display:flex;
    justify-content:space-around;
    margin:10px 0;
}

.ex-type, .comp-type {
    display:flex;
    flex-direction:column;
    align-items:center;
}

#exercise-types .circle, #competition-types .circle {
    width:30px;
    height:30px;
    border:2px solid white;
    border-radius:50%;
    background:#131313;
    cursor:pointer;
    transition: all 0.2s;
}

#competition-types .circle {
    background: #131313 !important;
}

#competition-types .circle.selected {
    background: white !important;
    border: 2px solid white;
    transform: none;
}

.circle {
    transition: all 0.2s;
}

.type-label {
    margin-top:5px;
    font-size:0.85rem;
    text-align:center;
}

input {
    width:100%;
    padding:8px;
    font-size:1rem;
    border-radius:8px;
    border:1px solid #ccc;
    margin-bottom:10px;
    box-sizing:border-box;
}

button#submit-competition, button#submit-exercise {
    margin-top:10px;
    padding:10px 25px;
    border:none;
    border-radius:20px;
    background:#9933FF;
    color:white;
    cursor:pointer;
    font-size:18px;
    display:block;
    margin-left:auto;
    margin-right:auto;
}

#comp-info-popup {
    width:40vw;
    max-width:400px;
    height:40vh;
    background:#131313;
    border:2px solid white;
    border-radius:25px;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    gap:20px;
    padding:20px;
    overflow-y:auto;
    font-size:1.2rem;
    line-height:1.6; 
}

#edit-event-btn {
    margin-top:10px;
    padding:10px 25px;
    border:none;
    border-radius:20px;
    background:#9933FF;
    color:white;
    cursor:pointer;
    font-size:18px;
}

#delete-event-btn {
    margin-top:10px;
    padding:10px 25px;
    border:none;
    border-radius:20px;
    background:#9933FF;
    color:white;
    cursor:pointer;
    font-size:18px;
}

.required-field {
    position:relative;
}

.required-field input {
    padding-right:20px;
}

.required-star {
    position:absolute;
    right:8px;
    top:50%;
    transform:translateY(-50%);
    color:#FF3B3B;
    font-weight:bold;
    pointer-events:none;
}

.month-nav {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-left: -1rem;
   margin-top: -1rem;
}

.month-nav button {
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    border: 2px solid black;
    background: white;
    color: black;
    cursor: pointer;
    font-size: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    padding: 0;
}

.month-nav button:hover {
    background: #131313;
    color: white;
    border: 2px solid white;
}

.exercise-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(170px, 1fr));
    gap: 15px;
    max-height: 35vh;
    overflow-y: auto;
    width: 100%;
    padding: 5px;
}

.exercise-tile {
    height: 80px;
    border-radius: 15px;
    color: white;
    cursor: pointer;
    text-align: center;
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: 0.2s;
    font-weight: bold;
    user-select: none;
}

.exercise-tile:hover {
    filter: brightness(85%);
}

.invalid-input {
    border: 2px solid #FF3B3B !important;
}

</style>

<script>
const plusBtn = document.getElementById("plus-btn");
const popupOverlay = document.getElementById("popup-overlay");
const addCompBtn = document.getElementById("add-comp-btn");
const addExBtn = document.getElementById("add-ex-btn");
const compForm = document.getElementById("competition-form");
const exForm = document.getElementById("exercise-form");
const popupSelection = document.getElementById("popup-selection");
const submitCompBtn = document.getElementById("submit-competition");
const circles = document.querySelectorAll(".circle");
const submitExBtn = document.getElementById("submit-exercise");
const prevBtn = document.getElementById("prev-month");
const nextBtn = document.getElementById("next-month");

let currentEventElement = null;
let currentEventData = null;
let currentExerciseData = null;
let currentMonth = {{ monthNumber }};
let currentYear = {{ year }};

const exerciseTypeMap = {
    "Cardio": "red",
    "Body Weight": "blue",
    "Resistance": "green",
    "Mixed": "yellow"
};

plusBtn.onclick = () => {
    resetCompForm();
    resetExForm();
    popupOverlay.style.display = "flex";
    compForm.style.display = "none";
    exForm.style.display = "none";
    popupSelection.classList.remove("top");
    document.getElementById("comp-id").value = "";
};

popupOverlay.onclick = (e) => {
    if(e.target === popupOverlay){
        popupOverlay.style.display = "none";
        compForm.style.display = "none";
        exForm.style.display = "none";
    }
};

addCompBtn.onclick = () => {
    compForm.style.display = "block";
    exForm.style.display = "none";
    popupSelection.classList.add("top");
};

addExBtn.onclick = () => {
    exForm.style.display = "block";
    compForm.style.display = "none";
    popupSelection.classList.add("top");
};

const compCircles = document.querySelectorAll("#competition-types .circle");

compCircles.forEach(circle => {
    circle.onclick = () => {
        circle.classList.toggle("selected");
    };
});

const exCircles = document.querySelectorAll("#exercise-types .circle");
exCircles.forEach(circle => {
    circle.onclick = () => {
        exCircles.forEach(c => c.style.background = "#131313");
        circle.style.background = circle.dataset.color;
    };
});

function resetCompForm() {
    document.getElementById("comp-id").value = "";
    document.getElementById("comp-name").value = "";
    document.getElementById("comp-date").value = "";
    document.getElementById("comp-time").value = "";
    document.getElementById("comp-distance").value = "";
    document.getElementById("comp-finish-time").value = "";

    document.querySelectorAll("#competition-types .circle").forEach(c => {
        c.classList.remove("selected");
        c.style.background = "#131313";
    });

    currentEventData = null;
    currentEventElement = null;
}

function resetExForm() {
    document.getElementById("ex-name").value = "";
    document.getElementById("ex-date").value = "";
    document.getElementById("ex-time-taken").value = "";
    document.getElementById("ex-calories").value = "";
    document.getElementById("ex-distance").value = "";
    document.getElementById("ex-machine").value = "";
    document.getElementById("ex-weight").value = "";
    document.getElementById("ex-sets-reps").value = "";

    document.querySelectorAll("#exercise-types .circle").forEach(c => {
        c.style.background = "#131313";
    });

    currentExerciseData = null;
}

submitCompBtn.onclick = async () => {

    const nameInput = document.getElementById("comp-name");
    const dateInput = document.getElementById("comp-date");
    const timeInput = document.getElementById("comp-time");
    const distanceInput = document.getElementById("comp-distance");
    const finishTimeInput = document.getElementById("comp-finish-time");

    const name = nameInput.value.trim();
    const date = dateInput.value;
    const time = timeInput.value;
    const distance = distanceInput.value.trim();
    const finishTime = finishTimeInput.value.trim();

    [nameInput, dateInput, timeInput, distanceInput, finishTimeInput].forEach(el => {
        el.classList.remove("invalid-input");
    });

    let valid = true;

    if (!name) { nameInput.classList.add("invalid-input"); valid = false; }
    if (!date) { dateInput.classList.add("invalid-input"); valid = false; }
    if (!time) { timeInput.classList.add("invalid-input"); valid = false; }
    if (!distance) { distanceInput.classList.add("invalid-input"); valid = false; }

    if (distance && !/^\d+(\.\d+)?$/.test(distance)) {
        distanceInput.classList.add("invalid-input");
        valid = false;
    }

    if (finishTime && !/^([0-1]\d|2[0-3]):([0-5]\d):([0-5]\d)$/.test(finishTime)) {
        finishTimeInput.classList.add("invalid-input");
        valid = false;
    }

    if (!valid) return;

    const formData = new URLSearchParams();
    const id = document.getElementById("comp-id").value;

    if (id && id !== "") {
        formData.append("id", id);
    }

    formData.append("name", name);
    formData.append("date", date);
    formData.append("time", time);
    formData.append("distance", distance);
    formData.append("finishTime", finishTime);

    let selectedTypes = [];
    document.querySelectorAll("#competition-types .circle.selected").forEach(c => {
        selectedTypes.push(c.dataset.name);
    });

    formData.append("types", selectedTypes.join(","));

    await fetch("/competitions/add", {
        method: "POST",
        body: formData
    });

    resetCompForm();
    window.location.reload();
};

function isFutureDate(dateString) {
    const selectedDate = new Date(dateString);
    const today = new Date();

    today.setHours(0, 0, 0, 0);
    selectedDate.setHours(0, 0, 0, 0);

    return selectedDate > today;
}

submitExBtn.onclick = async () => {

    const nameInput = document.getElementById("ex-name");
    const dateInput = document.getElementById("ex-date");
    const timeInput = document.getElementById("ex-time-taken");
    const caloriesInput = document.getElementById("ex-calories");
    const distanceInput = document.getElementById("ex-distance");
    const machineInput = document.getElementById("ex-machine");
    const weightInput = document.getElementById("ex-weight");
    const setsRepsInput = document.getElementById("ex-sets-reps");

    const name = nameInput.value.trim();
    const date = dateInput.value;
    const timeTaken = timeInput.value.trim();
    const calories = caloriesInput.value.trim();
    const distance = distanceInput.value.trim();
    const machine = machineInput.value.trim();
    const weight = weightInput.value.trim();
    const setsReps = setsRepsInput.value.trim();

    [nameInput, dateInput, timeInput, caloriesInput, distanceInput, machineInput, weightInput, setsRepsInput]
        .forEach(el => el.classList.remove("invalid-input"));

    let valid = true;

    if (!name) { nameInput.classList.add("invalid-input"); valid = false; }
    if (!date) { dateInput.classList.add("invalid-input"); valid = false; }
    if (date && isFutureDate(date)) {
        dateInput.classList.add("invalid-input");
        valid = false;
    }
    if (!timeTaken) { timeInput.classList.add("invalid-input"); valid = false; }
    if (!calories) { caloriesInput.classList.add("invalid-input"); valid = false; }

    if (distance && !/^\d+(\.\d+)?$/.test(distance)) {
        distanceInput.classList.add("invalid-input");
        valid = false;
    }

    if (calories && !/^\d+(\.\d+)?$/.test(calories)) {
        caloriesInput.classList.add("invalid-input");
        valid = false;
    }

    if (weight && !/^\d+(\.\d+)?$/.test(weight)) {
        weightInput.classList.add("invalid-input");
        valid = false;
    }

    if (machine && !/^[A-Za-z ]+$/.test(machine)) {
        machineInput.classList.add("invalid-input");
        valid = false;
    }

    if (timeTaken && !/^([0-1]\d|2[0-3]):([0-5]\d):([0-5]\d)$/.test(timeTaken)) {
        timeInput.classList.add("invalid-input");
        valid = false;
    }

    if (setsReps && !/^\d+\s*x\s*\d+$/i.test(setsReps)) {
        setsRepsInput.classList.add("invalid-input");
        valid = false;
    }

    if (!valid) return;

    const formData = new URLSearchParams();

    const id = currentExerciseData?.id;
    if (id) formData.append("id", id);

    formData.append("name", name);
    formData.append("date", date);
    formData.append("distance", distance);
    formData.append("timeTaken", timeTaken);
    formData.append("weight", weight);
    formData.append("machine", machine);
    formData.append("calories", calories);
    formData.append("setsReps", setsReps);

    let selectedType = null;

    document.querySelectorAll("#exercise-types .circle").forEach(c => {
        if (c.style.background !== "" && c.style.background !== "rgb(19, 19, 19)") {
            selectedType = c.nextElementSibling.textContent.trim();
        }
    });

    formData.append("type", selectedType);

    await fetch("/calendar-exercises/add", {
        method: "POST",
        body: formData
    });

    window.location.reload();
};

document.addEventListener("click", e => {
    const dot = e.target.closest(".exercise-dot");
    if (dot) {

        const overlay = document.getElementById("comp-info-overlay");
        const listView = document.getElementById("exercise-list-view");
        const detailView = document.getElementById("exercise-detail-view");

        const exercises = JSON.parse(dot.dataset.exercises);

        detailView.style.display = "none";
        listView.style.display = "grid";
        listView.className = "exercise-grid";
        listView.innerHTML = "";

        let color = "#FFC000";
        if (dot.classList.contains("red")) color = "#E32141";
        if (dot.classList.contains("blue")) color = "#0F95CB";
        if (dot.classList.contains("green")) color = "#196B24";
        if (dot.classList.contains("yellow")) color = "#FFC000";

        exercises.forEach(ex => {
            const tile = document.createElement("div");
            tile.className = "exercise-tile";
            tile.style.background = color;
            tile.textContent = ex.name;

            tile.onclick = () => {
                currentExerciseData = ex;
                showExerciseDetail(ex, color);
            };

            listView.appendChild(tile);
        });

        document.getElementById("comp-action-buttons").style.display = "none";
        overlay.style.display = "flex";
        return;
    }

    const pill = e.target.closest(".comp-pill");
    if(pill){
        const overlay = document.getElementById("comp-info-overlay");
        const popup = document.getElementById("comp-info-popup");
        const content = document.getElementById("comp-info-content");
        const info = JSON.parse(pill.dataset.info);
        currentEventElement = pill;
        currentEventData = info;
        document.getElementById("comp-id").value = info.id || "";
        
        const cleaned = (info.types || "")
            .toString()
            .trim()
            .replace(/^\[|\]$/g, "");

        const formattedTypes = cleaned
            .split(",")
            .map(t => t.trim())
            .filter(t => t)
            .join(", ");

        content.innerHTML = `
            <div><strong>Name:</strong> ${info.name}</div>
            <div><strong>Date:</strong> ${info.date}</div>
            <div><strong>Start Time:</strong> ${info.time}</div>
            <div><strong>Distance (km):</strong> ${info.distance}</div>
            <div><strong>Time Taken (hh:mm:ss):</strong> ${info.finishTime}</div>
            <div><strong>Type(s):</strong> ${formattedTypes}</div>
        `;
        overlay.style.display = "flex";
        document.getElementById("comp-action-buttons").style.display = "flex";
    }
    const infoOverlay = document.getElementById("comp-info-overlay");
    if(e.target === infoOverlay){
        infoOverlay.style.display = "none";
    }
});

document.getElementById("edit-event-btn").onclick = () => {

    if(currentEventData){
        document.getElementById("comp-name").value = currentEventData.name || "";
        document.getElementById("comp-date").value = currentEventData.date || "";
        document.getElementById("comp-time").value = currentEventData.time || "";
        document.getElementById("comp-distance").value = currentEventData.distance || "";
        document.getElementById("comp-finish-time").value = currentEventData.finishTime || "";

        document.querySelectorAll("#competition-types .circle").forEach(c => {
            c.classList.remove("selected");
        });

        const types = (currentEventData.types || "")
            .toString()
            .replace(/[\[\]]/g, "")
            .split(",")
            .map(t => t.trim());

        document.querySelectorAll("#competition-types .circle").forEach(c => {
            if (types.includes(c.dataset.name)) {
                c.classList.add("selected");
            }
        });

        popupOverlay.style.display = "flex";
        compForm.style.display = "block";
        exForm.style.display = "none";
        popupSelection.classList.add("top");

        document.getElementById("comp-info-overlay").style.display = "none";
        return;
    }

    if(currentExerciseData) {

        document.getElementById("ex-name").value = currentExerciseData.name || "";
        document.getElementById("ex-date").value = currentExerciseData.date || "";
        document.getElementById("ex-distance").value = currentExerciseData.distance || "";
        document.getElementById("ex-time-taken").value = currentExerciseData.timeTaken || "";
        document.getElementById("ex-weight").value = currentExerciseData.weight || "";
        document.getElementById("ex-machine").value = currentExerciseData.machine || "";
        document.getElementById("ex-calories").value = currentExerciseData.calories || "";
        document.getElementById("ex-sets-reps").value = currentExerciseData.setsReps || "";

        document.querySelectorAll("#exercise-types .circle").forEach(c => {
            c.style.background = "#131313";

            if (c.nextElementSibling.textContent === currentExerciseData.type) {
                c.style.background = c.dataset.color;
            }
        });

        popupOverlay.style.display = "flex";
        exForm.style.display = "block";
        compForm.style.display = "none";
        popupSelection.classList.add("top");

        document.getElementById("comp-info-overlay").style.display = "none";
    }
};

prevBtn.onclick = () => {
    currentMonth--;
    if (currentMonth < 1) {
        currentMonth = 12;
        currentYear--;
    }
    reloadCalendar();
};

nextBtn.onclick = () => {
    currentMonth++;
    if (currentMonth > 12) {
        currentMonth = 1;
        currentYear++;
    }
    reloadCalendar();
};

function reloadCalendar() {
    window.location.href = `/calendar?month=${currentMonth}&year=${currentYear}`;
}

function showExerciseDetail(ex, color) {
    const listView = document.getElementById("exercise-list-view");
    const detailView = document.getElementById("exercise-detail-view");
    const actionBtns = document.getElementById("comp-action-buttons");

    listView.style.display = "none";
    detailView.style.display = "block";

    actionBtns.style.display = "flex";

    detailView.innerHTML = `
        <div style="
            background:${color};
            padding:15px;
            border-radius:15px;
            text-align:center;
            margin-bottom:15px;
            font-size:18px;
        ">
            <strong>${ex.name}</strong>
        </div>

        ${ex.distance ? `<div>Distance (km): ${ex.distance} km</div>` : ""}
        ${ex.timeTaken ? `<div>Time: ${ex.timeTaken}</div>` : ""}
        ${ex.weight ? `<div>Weight (kg): ${ex.weight} kg</div>` : ""}
        ${ex.machine ? `<div>Machine: ${ex.machine}</div>` : ""}
        ${ex.calories ? `<div>Calories (kcal): ${ex.calories}</div>` : ""}
        ${ex.setsReps ? `<div>Sets & Reps: ${ex.setsReps}</div>` : ""}
    `;
}

document.getElementById("exercise-detail-view").onclick = () => {
    document.getElementById("exercise-detail-view").style.display = "none";
    document.getElementById("exercise-list-view").style.display = "grid";

    document.getElementById("comp-action-buttons").style.display = "none";
};

const deleteBtn = document.getElementById("delete-event-btn");

deleteBtn.onclick = async () => {

    if (currentEventData && currentEventData.id) {

        if (!confirm("Delete this competition?")) return;

        const formData = new URLSearchParams();
        formData.append("id", currentEventData.id);

        await fetch("/competitions/delete", {
            method: "POST",
            body: formData
        });

        window.location.reload();
        return;
    }

    if (currentExerciseData && currentExerciseData.id) {

        if (!confirm("Delete this exercise?")) return;

        const formData = new URLSearchParams();
        formData.append("id", currentExerciseData.id);

        await fetch("/calendar-exercises/delete", {
            method: "POST",
            body: formData
        });

        window.location.reload();
    }
};

const today = new Date().toISOString().split("T")[0];

document.getElementById("ex-date").setAttribute("max", today);

</script>
{% endblock %}
