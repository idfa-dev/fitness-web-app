{% extends "base.peb" %}

{% block title %}Profile{% endblock %}

{% block header %}

{% endblock %}

{% block content %}
<h1>Profile</h1>
<a href="/profile/profile_info" class="profile-info-button">Edit Profile</a>
<a href="/sign-in" class="logout-btn">Logout</a>

<div class="chart-container">
    <canvas id="workoutChart"></canvas>
</div>
<div class="donut-row">
    <div class="donut-container">
        <canvas id="caloriesChart"></canvas>
    </div>
    <div class="donut-container">
        <canvas id="distanceChart"></canvas>
    </div>
    <div class="donut-container">
        <canvas id="numWorkoutsChart"></canvas>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

const weeklyData = {{ weeklyData | raw }};
const labels = ["Mon","Tue","Wed","Thu","Fri","Sat","Sun"];

const data = [
    weeklyData.Mon,
    weeklyData.Tue,
    weeklyData.Wed,
    weeklyData.Thu,
    weeklyData.Fri,
    weeklyData.Sat,
    weeklyData.Sun
];

console.log("chart data:", data)

const ctx = document.getElementById("workoutChart");

new Chart(ctx, {
    type: 'bar',
    data: {
        labels: labels,
        datasets: [{
            label: "Exercise Minutes",
            data: data,
            backgroundColor: "#b73fec"
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: {
                labels: {
                    color: "white"
                }
            }
        },
        scales: {
            x: {
                ticks: {
                    color: "white"
                }
            },
            y: {
                ticks: {
                    color: "white"
                },
                title: {
                    display: true,
                    text: "Minutes",
                    color: "white",
                    font: {
                        size: 14
                    }
                },
                beginAtZero: true
            }
        }
    }
});

function createDonutChart(canvasId, progress, goal, color, title, measurement) {
    const ctx = document.getElementById(canvasId);

    if (!ctx) return;

    new Chart(ctx, {
        type: "doughnut",
        data: {
            labels: ["Complete", "Remaining"],
            datasets: [{
                data: [progress, goal - progress],
                backgroundColor: [color, "#000000"],
                borderWidth: 0,
            }]
        },
        options: {
            cutout: "70%",
            plugins: {
                legend: { display: false }
            }
        },
        plugins: [{
            id: 'centerText',
            beforeDraw(chart) {
                const { width, height, ctx } = chart;

                ctx.restore();

                const centerX = width / 2;
                const centerY = height / 2;

                ctx.textAlign = "center";
                ctx.textBaseline = "middle";
                ctx.fillStyle = "white";

                ctx.font = "20px Arial";
                ctx.fillText(`${title} ${measurement}`, centerX, centerY - 10);

                ctx.font = "16px Arial";
                ctx.fillText(`${progress} / ${goal}`, centerX, centerY + 15);

                ctx.save();
            }
        }]
    });
}

createDonutChart("caloriesChart", 1800, 2500, "#DE3163", "Calories Burnt", "(kcal)"); // put measurement in brackets
createDonutChart("distanceChart", 7.5, 15, "#4DD0E1", "Distance", "(km)");
createDonutChart("numWorkoutsChart", 3, 5, "#FF9F43", "Workouts", "");

</script>
{% endblock %}