{% extends "base.peb" %}

{% block title %}Profile{% endblock %}

{% block header %}

{% endblock %}

{% block content %}
<h1>Profile</h1>
<a href="/profile/profile_info" class="profile-info-button">Edit Profile</a>
<a href="/sign-in" class="logout-btn">Logout</a>

<div class="chart-container">
    <canvas id="workoutChart"></canvas>
</div>
<div class="donut-row">
    <div class="donut-container">
        <canvas id="caloriesChart"></canvas>
    </div>
    <div class="donut-container">
        <canvas id="distanceChart"></canvas>
    </div>
    <div class="donut-container">
        <canvas id="numWorkoutsChart"></canvas>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
const labels = ["Mon","Tue","Wed","Thu","Fri","Sat","Sun"];

const cardioData = [30, 20, 40, 25, 35, 50, 45];
const bodyweightData = [15, 25, 20, 30, 10, 20, 15];
const resistanceData = [20, 30, 25, 35, 40, 30, 20];
const mixedData = [10, 15, 5, 20, 15, 10, 25];

const ctx = document.getElementById("workoutChart");

new Chart(ctx, {
    type: 'bar',
    data: {
        labels: labels,
        datasets: [
            {
                label: "Cardio",
                data: cardioData,
                backgroundColor: "red"
            },
            {
                label: "Bodyweight",
                data: bodyweightData,
                backgroundColor: "blue"
            },
            {
                label: "Resistance",
                data: resistanceData,
                backgroundColor: "green"
            },
            {
                label: "Mixed",
                data: mixedData,
                backgroundColor: "yellow"
            }
        ]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: {
                labels: {
                    color: "white"
                }
            }
        },
        scales: {
            x: {
                ticks: {
                    color: "white"
                }
            },
            y: {
                ticks: {
                    color: "white"
                },
                title: {
                    display: true,
                    text: "Minutes",
                    color: "white",
                    font: {
                        size: 14
                    }
                },
                beginAtZero: true
            }
        }
    }
});

function createDonutChart(canvasId, progress, goal, color, title, measurement) {
    const ctx = document.getElementById(canvasId);

    if (!ctx) return;

    new Chart(ctx, {
        type: "doughnut",
        data: {
            labels: ["Complete", "Remaining"],
            datasets: [{
                data: [progress, goal - progress],
                backgroundColor: [color, "#000000"],
                borderWidth: 0,
            }]
        },
        options: {
            cutout: "70%",
            plugins: {
                legend: { display: false }
            }
        },
        plugins: [{
            id: 'centerText',
            beforeDraw(chart) {
                const { width, height, ctx } = chart;

                ctx.restore();

                const centerX = width / 2;
                const centerY = height / 2;

                ctx.textAlign = "center";
                ctx.textBaseline = "middle";
                ctx.fillStyle = "white";

                ctx.font = "20px Arial";
                ctx.fillText(`${title} ${measurement}`, centerX, centerY - 10);

                ctx.font = "16px Arial";
                ctx.fillText(`${progress} / ${goal}`, centerX, centerY + 15);

                ctx.save();
            }
        }]
    });
}

createDonutChart("caloriesChart", 1800, 2500, "#b73fec", "Calories Burnt", "(kcal)"); // put measurement in brackets
createDonutChart("distanceChart", 7.5, 15, "red", "Distance", "(km)");
createDonutChart("numWorkoutsChart", 3, 5, "green", "Workouts", "");

</script>
{% endblock %}