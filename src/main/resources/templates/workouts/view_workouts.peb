{% extends "base.peb" %}
{# Note: 'workout' may seem like an error (underlined in red) but this is just due to the Pebble linter. The code runs fine.  #}
{% set types = ["C", "B", "R", "M"] %} {# list containing exercise types #}
{% set colours = ["E32141", "0F95CB", "196B24", "FFC000"] %} {#  list containing exercise type colours #}
{% block title %} View Workouts {% endblock %}

{% block header %}

{% endblock %}
{% block content %}
    {%  if currentPage == "workouts" %}
    <div class="top-right-btn">
        <a href="/workouts/past">
            <button>Past<br>Workouts</button>
        </a>
    </div>
    {% endif %}

    <div class="center">
        <div class="search-filter-wrapper">
            <form method="get" action="/workouts/view/search" class="search-container">
                <input type="hidden" name="isCurrentWorkout" value="{{ currentPage == 'workouts' ? 'false' : 'true' }}">

                <input type="text" name="search" class="search" placeholder="Search for a workout...">

                <button type="submit" class="btn-reset search-btn">
                    <img src="/static/images/magnifying_glass_icon.png" alt="submit">
                </button>
            </form>

            <form method="get" action="/workouts/view/search" class="filter-form">

                <input type="hidden" name="isCurrentWorkout" value="{{ currentPage == 'workouts' ? 'false' : 'true' }}">

                <label><input type="checkbox" name="type" value="C"> Cardio</label>
                <label><input type="checkbox" name="type" value="B"> Bodyweight</label>
                <label><input type="checkbox" name="type" value="R"> Resistance</label>
                <label><input type="checkbox" name="type" value="M"> Mixed</label>
                <label><input type="checkbox" name="favourite" value="true"> Favourited</label>

                <button type="submit" class="filter-btn">Apply Filters</button>
            </form>
        </div>
    </div>

    <div class="center">
        <p> Key: C = Cardio, B = Bodyweight, R = Resistance, M = Mixed
    </div>
    <div class="center">
        <form>
            <table>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Contains</th>
                    <th>Favourited</th>
                </tr>
                {% for w in workouts %}
                    {% set contain = [] %}
                    <tr>
                        <td>
                            {% if currentPage == "workouts" %}
                                <button class="workout-btn" type="submit" name="favourite" formaction="/workouts/{{ w.workout['id'] }}" formmethod="get">{{ w.workout['name'] }}</button>
                            {% elseif currentPage == "current-workout" %}
                                <button class="workout-btn" type="input" name="workout_template" value={{ w.workout['id'] }} formaction="/current-workout" formmethod="post">{{ w.workout['name'] }}</button>
                            {% else %}
                                <a href="/workouts/{{ w.workout['id'] }}">
                                    {{ w.workout['name'] }}
                                </a>
                            {% endif %}
                        </td>
                        <td>{{ w.workout['desc'] }}</td>
                        <td>{{ w.types }}</td>
                        <td>
                            {% if w.workout['favourite'] == false %}
                                <button class="icon-btn" type="submit" name="favourite" value="{{ w.workout['id'] }}" formaction="/workouts/view?from={{ currentPage }}" formmethod="post"><i class="fa-regular fa-heart"></i></button>
                            {% else %}
                                <button class="icon-btn" type="submit" name="favourite" value="{{ w.workout['id'] }}" formaction="/workouts/view?from={{ currentPage }}" formmethod="post"><i class="fa-solid fa-heart"></i></button>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </table>
        </form>
    </div>
{% endblock %}