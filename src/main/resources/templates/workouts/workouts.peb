{% extends "base.peb" %}

{% block title %}Workouts{% endblock %}

{% block content %}
<div class="center">
    {% if errMsg != null %}
    <h3> Error: {{ errMsg }} </h3>
    {% endif %}
    <div class="button-container">
        <a href="/workouts/view">
            <button> View Workouts </button>
        </a>
    </div>
    <div class="button-container">
        <a href="/workouts/past">
            <button> Past Workouts </button>
        </a>
    </div>
</div>

{% endblock %}