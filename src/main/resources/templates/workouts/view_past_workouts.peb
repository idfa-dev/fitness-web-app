{% extends "base.peb" %}
{# Note: 'workout' may seem like an error (underlined in red) but this is just due to the Pebble linter. The code runs fine.  #}
{% set types = ["C", "B", "R", "M"] %} {# list containing exercise types #}
{% set colours = ["E32141", "0F95CB", "196B24", "FFC000"] %} {#  list containing exercise type colours #}
{% block title %} View Past Workouts {% endblock %}

{% block header %}

{% endblock %}
{% block content %}
    <div class="center">
        <h1> {{ errMsg }} </h1>
    </div>
    <div class="center">
        <table>
            <tr>
                <th>Date Completed</th>
                <th>Exercises</th>
                <th>Sets</th>
                <th>Length (HH:MM:SS)</th>
            </tr>
            {% for workout in pastWorkouts %}
                <tr>
                    <td>{{ workout.endedAt }}</td>
                    <td>
                        {% for weo in workout.workoutExercisesObject %}
                            {{ weo.exercise.exercise.name }}<br>
                        {% endfor %}
                    </td>
                    <td>
                        {% for weo in workout.workoutExercisesObject %}
                            {{ weo.exercise.exercise.name }}
                            <br>
                            {% for set in weo.sets %}
                                Weight: {{ set.weight }}, Reps: {{ set.reps }} <br>
                            {% endfor %}
                            <br>
                        {% endfor %}
                    </td>
                    <td>{{ workout.length }}</td>
                </tr>
            {% endfor %}
        </table>
    </div>
{% endblock %}