{% extends "base.peb" %}

{% block title %}Calendar{% endblock %}

{% block header %}{% endblock %}

{% block content %}
<div class="calendar-container">
    <div class="month-year">{{ month }} {{ year }}</div>
    <button id="plus-btn">+</button>
    {{ calendarTable | raw }}

    <div id="popup-overlay">
        <div id="popup">
            <button class="popup-btn" id="add-competition-btn">Add Competition</button>
            <button class="popup-btn" id="add-exercise-btn">Add Exercise</button>
        </div>
    </div>

    <div id="form-overlay">
        <div id="competition-form">
            <h2>Add Competition</h2>
            <input type="text" id="comp-name" placeholder="Competition Name">
            <input type="date" id="comp-date">
            <input type="time" id="comp-time">
            <button id="comp-submit">Submit</button>
            <button id="comp-cancel">Cancel</button>
        </div>
    </div>
</div>

<style>
html, body{
    margin:0;
    padding:0;
    height:100%;
    background-color:#131313;
    font-family:"Agency FB", sans-serif;
    color:white;
}

.page-title-container{
    display:none;
}

.calendar-container{
    width:100%;
    position:relative;
    padding-bottom:0.5rem;
}

.month-year{
    font-size:6vh;
    font-weight:bold;
    margin-top:-1rem;
    margin-left:3rem;
}

#plus-btn{
    position:absolute;
    top:0.2rem;
    right:1rem;
    width:4rem;
    height:4rem;
    font-size:2rem;
    border-radius:50%;
    border:2px solid black;
    background:white;
    color:black;
    cursor:pointer;
}

#plus-btn:hover{
    background:#131313;
    color:white;
    border:2px solid white;
}

table.calendar{
    border-collapse:collapse;
    width:80vw;
    max-width:1200px;
    text-align:center;
    margin:0.5rem 0 0 3rem;
}

table.calendar th, table.calendar td{
    border:1px solid white;
    padding:0.5rem;
    height:3.5rem;
    width:calc(80vw / 7);
    position:relative;
}

table.calendar th{
    text-transform:uppercase;
    font-weight:bold;
    font-size:2rem;
}

table.calendar td{
    vertical-align:top;
    color:white;
    font-size:1.5rem;
}

.day-number{
    position:absolute;
    top:0.2rem;
    right:0.2rem;
}

#popup-overlay{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:100%;
    display:flex;
    justify-content:center;
    align-items:center;
    background:rgba(0,0,0,0.4);
    z-index:1000;
}

#popup{
    width:60vw;
    height:60vh;
    background:#131313;
    border:2px solid white;
    border-radius:25px;
    display:flex;
    flex-direction:row;
    justify-content:center;
    align-items:center;
    gap:70px;
    padding:20px;
}

.popup-btn{
    background:#9933FF;
    color:white;
    border:none;
    border-radius:25px;
    width:280px;
    height:100px;
    font-size:24px;
    cursor:pointer;
}

#form-overlay{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:100%;
    display:none;
    justify-content:center;
    align-items:center;
    background:rgba(0,0,0,0.5);
    z-index:1100;
}

#competition-form{
    width:50vw;
    background:#131313;
    border:2px solid white;
    border-radius:20px;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:20px;
    padding:30px;
}

#competition-form input{
    width:70%;
    padding:10px;
    border-radius:15px;
    border:none;
    font-size:18px;
    text-align:center;
}

#competition-form button{
    width:50%;
    padding:14px;
    border-radius:25px;
    border:none;
    font-size:18px;
    background:#9933FF;
    color:white;
    cursor:pointer;
}

#competition-form #comp-cancel{
    background:#555555;
}
</style>

<script>
const plusBtn = document.getElementById("plus-btn");
const popupOverlay = document.getElementById("popup-overlay");
const addCompetitionBtn = document.getElementById("add-competition-btn");
const formOverlay = document.getElementById("form-overlay");
const compCancel = document.getElementById("comp-cancel");
const compSubmit = document.getElementById("comp-submit");

plusBtn.onclick = function() {
    popupOverlay.style.display = "flex";
};

popupOverlay.onclick = function(e) {
    if (e.target === popupOverlay) {
        popupOverlay.style.display = "none";
    }
};

addCompetitionBtn.onclick = function() {
    popupOverlay.style.display = "none";
    formOverlay.style.display = "flex";
};

compCancel.onclick = function() {
    formOverlay.style.display = "none";
};

compSubmit.onclick = function() {
};
</script>
{% endblock %}

