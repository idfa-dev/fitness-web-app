{% extends "base.peb" %}

{% block title %}Calendar{% endblock %}

{% block header %}{% endblock %}

{% block content %}
<div class="calendar-container">
    <div class="month-year">{{ month }} {{ year }}</div>
    <button id="plus-btn">+</button>
    {{ calendarTable | raw }}

    <div id="popup-overlay">
        <div id="popup">
            <button class="popup-btn">Add Competition</button>
            <button class="popup-btn">Add Exercise</button>
        </div>
    </div>
</div>

<style>
html, body{
    margin:0;
    padding:0;
    height:100%;
    background-color:#131313;
    font-family:"Agency FB", sans-serif;
    color:white;
}

.page-title-container{
    display:none;
}

.calendar-container{
    width:100%;
    position:relative;
    padding-bottom:0.5rem;
}

.month-year{
    font-size:6vh;
    font-weight:bold;
    margin-top:-1rem;
    margin-left:3rem;
}

#plus-btn{
    position:absolute;
    top:0.2rem;
    right:1rem;
    width:4rem;
    height:4rem;
    font-size:2rem;
    border-radius:50%;
    border:2px solid black;
    background:white;
    color:black;
    cursor:pointer;
}

#plus-btn:hover{
    background:#131313;
    color:white;
    border:2px solid white;
}

table.calendar{
    border-collapse:collapse;
    width:80vw;
    max-width:1200px;
    text-align:center;
    margin:0.5rem 0 0 3rem;
}

table.calendar th, table.calendar td{
    border:1px solid white;
    padding:0.5rem;
    height:3.5rem;
    width:calc(80vw / 7);
    position:relative;
}

table.calendar th{
    text-transform:uppercase;
    font-weight:bold;
    font-size:2rem;
}

table.calendar td{
    vertical-align:top;
    color:white;
    font-size:1.5rem;
}

.day-number{
    position:absolute;
    top:0.2rem;
    right:0.2rem;
}

#popup-overlay{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:100%;
    display:none;
    justify-content:center;
    align-items:center;
    background:rgba(0,0,0,0.4);
    z-index:1000;
}

#popup{
    width:60vw;
    height:60vh;
    background:#131313;
    border:2px solid white;
    border-radius:25px;
    display:flex;
    flex-direction:row;
    justify-content:center;
    align-items:center;
    gap:100px;
    padding:20px;
}

.popup-btn{
    background:#9933FF;
    color:white;
    border:none;
    border-radius:25px;
    width:280px;
    height:100px;
    font-size:24px;
    cursor:pointer;
}
</style>

<script>
const plusBtn=document.getElementById("plus-btn");
const popupOverlay=document.getElementById("popup-overlay");

plusBtn.onclick=function(){
    popupOverlay.style.display="flex";
};

popupOverlay.onclick=function(e){
    if(e.target===popupOverlay){
        popupOverlay.style.display="none";
    }
};
</script>
{% endblock %}
