{% extends "base.peb" %}
{# Note: 'workout' may seem like an error (underlined in red) but this is just due to the Pebble linter. The code runs fine.  #}
{% set types = ["C", "B", "R", "M"] %} {# list containing exercise types #}
{% set colours = ["E32141", "0F95CB", "196B24", "FFC000"] %} {#  list containing exercise type colours #}
{% block title %} View Workouts {% endblock %}

{% block header %}

{% endblock %}
{% block content %}
    <div class="center">
        <div class="search-filter-wrapper">
            <form method="get" class="search-container" action="/workouts/view/search">

                <input type="text" name="search" class="search" placeholder="Search for a workout...">

                <button type="submit" class="btn-reset search-btn">
                    <img src="/static/images/magnifying_glass_icon.png" alt="submit">
                </button>
            </form>

            <form method="get" action="/workouts/view/search" class="filter-form">

                <label><input type="checkbox" name="type" value="C"> Cardio</label>
                <label><input type="checkbox" name="type" value="B"> Bodyweight</label>
                <label><input type="checkbox" name="type" value="R"> Resistance</label>
                <label><input type="checkbox" name="type" value="M"> Mixed</label>

                <button type="submit" class="filter-btn">Apply Filters</button>
            </form>
        </div>
    </div>

    <div class="center">
        <p> Key: C = Cardio, B = Bodyweight, R = Resistance, M = Mixed
    </div>
    <div class="center">
        <table>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Contains</th>
            <th>Favourited</th>
        </tr>
        {% for w in workouts %}
            {% set contain = [] %}
            <tr>
                <td><a href="/workouts/{{ w.workout['id'] }}">{{ w.workout['name'] }}</a></td>
                <td>{{ w.workout['desc'] }}</td>
                <td>{{ w.types }}</td>
                <td>{{ w.workout['favourited'] }}</td>
            </tr>
        {% endfor %}
        </table>
    </div>
{% endblock %}

{% block scripts %}
<script>
const filterBtn = document.getElementById("filterBtn");
const filterOptions = document.getElementById("filterOptions");

filterBtn.addEventListener("click", () => {
    filterOptions.style.display =
        filterOptions.style.display === "none" ? "block" : "none";
});
</script>
{% endblock %}