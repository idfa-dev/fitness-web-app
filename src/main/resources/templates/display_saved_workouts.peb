{% extends "base.peb" %}
{% set w = ["Cardio", "Bodyweight", "Resistance", "Mixed"] %} {# list containing workout types #}
{% set colours = ["E32141", "0F95CB", "196B24", "FFC000"] %} {#  list containing workout type colours #}
{% block title %} Saved Workouts {% endblock %}

{% block header %}
<div class="center">
    <h1>SAVED WORKOUTS</h1>
</div>

{% endblock %}
{% block content %}
    {% for savedWorkout in savedWorkouts %}
        <a class="workout-container" style="--bgc: #{{ colours[savedWorkout.workout['type']] }};" href="/workouts/{{ savedWorkout.workout['id'] }}">
            <p><b> {{ savedWorkout.workout['name'] }} </b></p>
            <p style="font-size: 16px;"><em> {{ savedWorkout.workout['desc'] }} </em></p>
        </a>
    {% endfor %}
{% endblock %}