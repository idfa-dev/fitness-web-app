{% extends "base.peb" %}

{% block title %}Home{% endblock %}

{% block content %}

<div style="text-align: center">
    <img src="/static/images/jympal_logo.png" alt="Jympal logo" style="width: 180px; margin-top: -30px;">
    <p style="font-size: 16px; margin: 5px 0;">
        You wanna be fit? Jymit!
    </p>
</div>

<p style="text-align: center; margin-top: 25px; font-weight: bold;">
    Your Activity:
</p>

<div class="home-row">

    <div class="home-box">
        <img src="/static/images/running.png" alt="Running" style="width: 220px; height: auto;">
    </div>

    <div class="home-box calorie-box">

        <div class="box-title">
            Calories Burnt Today
        </div>

        <div class="box-content">
            <div class="chart-wrapper">
                <canvas id="homeCaloriesChart"></canvas>
            </div>

            <div class="chart-value">
                1800 / 2500 kcal
            </div>
        </div>

    </div>

    <div class="home-box">
        <img src="/static/images/running.png" alt="Running" style="width: 220px; height: auto;">
    </div>

</div>

<p style="text-align: center; margin-top: 20px; font-weight: bold;">
    Suggestions:
</p>

<div class="home-row">

    <div class="home-box suggestion-box">
        <div class="suggestion-title">
            Start Workout Or Exercise
        </div>

        <div class="suggestion-text">
            Start a workout using a ready-made template or fully create your own routine!
        </div>
    </div>

    <div class="home-box suggestion-box">
        <div class="suggestion-title">
            Log Activity On Calendar
        </div>

        <div class="suggestion-text">
            Keep your fitness schedule organised and never miss a session!
        </div>
    </div>

    <div class="home-box suggestion-box">
        <div class="suggestion-title">
            View Personal Stats
        </div>

        <div class="suggestion-text">
            Analyse calories burnt, workout history, and overall performance!
        </div>
    </div>

</div>

<style>

.calorie-box {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    padding: 10px;
}

.box-title {
    font-weight: bold;
    font-size: 16px;
    text-align: center;
    width: 100%;
    margin-bottom: 8px;
    margin-top: 5px;
}

.box-content {
    flex: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding-top: 10px;
}

.chart-wrapper {
    width: 145px;
    height: 145px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.chart-wrapper canvas {
    width: 100% !important;
    height: 100% !important;
}

.chart-value {
    font-size: 14px;
    text-align: center;
    width: 100%;
}

.home-box {
    height: 250px;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
}

.home-box img {
    margin-top: -10px;
}

.suggestion-box {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 10px;
    padding: 15px;
    box-sizing: border-box;
}

.suggestion-title {
    font-weight: bold;
    font-size: 16px;
}

.suggestion-text {
    font-size: 14px;
    color: #cccccc;
    line-height: 1.4;
}

</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
function createDonutChart(canvasId, progress, goal, color) {
    const ctx = document.getElementById(canvasId);

    if (!ctx) return;

    new Chart(ctx, {
        type: "doughnut",
        data: {
            datasets: [{
                data: [progress, Math.max(goal - progress, 0)],
                backgroundColor: [color, "#222222"],
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: "70%",
            plugins: {
                legend: { display: false },
                tooltip: { enabled: false }
            }
        }
    });
}

createDonutChart("homeCaloriesChart", 1800, 2500, "#DE3163");
</script>

{% endblock %}