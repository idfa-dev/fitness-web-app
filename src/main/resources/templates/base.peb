<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Fitness App{% endblock %}</title>
    <link rel="stylesheet" href="/static/stylesheet.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>

<body>

<!-- NAVBAR -->
<div class="navbar">
    <a href="/home" class="tab {% if currentPage == 'home' %}active{% endif %}">Home</a>
    <a href="/current-workout" class="tab {% if currentPage == 'current-workout' %}active{% endif %}">Current Workout</a>
    <a href="/workouts" class="tab {% if currentPage == 'workouts' %}active{% endif %}">Workouts</a>
    <a href="/exercises" class="tab {% if currentPage == 'exercises' %}active{% endif %}">Exercises</a>
    <a href="/calendar" class="tab {% if currentPage == 'calendar' %}active{% endif %}">Calendar</a>
    <a href="/profile" class="tab {% if currentPage == 'profile' %}active{% endif %}">Profile</a>
</div>


<!-- BACKGROUND + PAGE CONTENT -->
<div class="landing-bg">

    <img class="bg-img" src="/static/images/landing_background.png" alt="background">

    <div class="landing-box" style="margin-top: -50px; height: 85%;">

        <!-- PAGE CONTENT -->
        <div class="content">
            {% block content %}{% endblock %}
        </div>

    </div>
</div>

{% block scripts %}{% endblock %}
</body>
</html>