{% extends "base.peb" %}

{% block title %}Profile Info{% endblock %}

{% block header %}
Profile Info
{% endblock %}

{% block content %}
<div class="profile-form-container">
    <form method="post" action="/profile/profile_info" class="profile-form">
        <div class="form-row">
            <label>Username:</label>
            <input type="text" name="username">
        </div>

        <div class="form-row">
            <label>Sex:</label>
            <select name="sex">
                <option value="">*optional*</option>
                <option value="male">Male</option>
                <option value="female">Female</option>
                <option value="other">Other</option>
                <option value="prefer_not">Prefer not to say</option>
            </select>
        </div>

        <div class="form-row">
            <label>Age:</label>
            <input type="number" name="age" placeholder="*optional*">
        </div>

        <div class="form-row">
            <label>Height (cm):</label>
            <input type="number" name="height" placeholder="*optional*">
        </div>

        <div class="form-row">
            <label>Weight (kg):</label>
            <input type="number" name="weight" placeholder="*optional*">
        </div>

        <div class="form-submit">
            <button type="submit" class="save-btn">Save</button>
        </div>
    </form>
</div>
{% endblock %}