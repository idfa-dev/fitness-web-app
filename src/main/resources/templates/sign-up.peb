<link rel="stylesheet" href="/static/stylesheet.css">

<title> Sign-In </title>

<div class style="text-align: center">
    <img src="/static/images/jympal_logo.png" alt="Jympal logo" style = "width: 20%; margin-top:1%" >
    <div class="page-title"> SIGN UP </div>
</div>

{% block action %}
{% endblock %}

{% block content %}

<div class style="text-align: center">
    
    <div class = "box" style =" width: 600px; height: auto; border: 2px solid white; background: transparent; margin: auto;">
    
        <p style = "font-size: 30px"> E-mail: <input type="text" style = "margin-left: 20px"></input></p>
        <p style = "font-size: 30px"> Username: <input type="text" style = "margin-left: 20px"></input></p>
        <p style = "font-size: 30px"> Password:  <input type="text" style = "margin-left: 20px"></input></p>

        <label>Casual<input type="radio" name="toggle" value="on"></label>
        <label>Competitor<input type="radio" name="toggle" value="on"></label>
        <label>Personal Trainer<input type="radio" name="toggle" value="on"></label>
        
        <p></p>
        
        <button class="page-action"> SIGN UP </button>
        <p style = "margin-top: 10px" > Already have an account? 
        <a href="/sign-in" style ="color: #510071"> Sign In </a>
        </p>
    </div>
</div>

{% endblock %}