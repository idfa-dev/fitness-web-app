{% extends "base.peb" %}

{% block title %}Exercises{% endblock %}

{% block content %}
<div class="center">
    <form class="search-container" action=#>
        <input type="text" class="search" placeholder="Search for an exercise...">
        <button type="submit" class="btn-reset search-btn">
            <img src="/static/images/magnifying_glass_icon.png" alt="submit">
        </button>
    </form>
</div>
<div class="center" style="width: 100%;">
{% for exercise in exercises %}
    {% if exercise['type'] == 0 %}
        <a href="/exercises/{{ exercise['id'] }}" class="cardio-exercise-selection-container">
        {{ exercise['name'] }}
    </a>
    {% elseif exercise['type'] == 1 %}
        <a href="/exercises/{{ exercise['id'] }}" class="bodyweight-exercise-selection-container">
        {{ exercise['name'] }}
    </a>
    {% elseif exercise['type'] == 2 %}
        <a href="/exercises/{{ exercise['id'] }}" class="resistance-exercise-selection-container">
        {{ exercise['name'] }}
    </a>
    {% elseif exercise['type'] == 3 %}
        <a href="/exercises/{{ exercise['id'] }}" class="mixed-exercise-selection-container">
        {{ exercise['name'] }}
    </a>
    {% endif %}
{% endfor %}
</div>

{% endblock %}