<link rel="stylesheet" href="/static/stylesheet.css">

<title> Sign-In </title>

<div class style="text-align: center">
    <img src="/static/images/jympal_logo.png" alt="Jympal logo" style = "width: 20%; margin-top:1%" >
    <div class="page-title"> SIGN IN </div>
</div>

{% block action %}
{% endblock %}

{% block content %}

<div class style="text-aligzn: center">
    
    <div class = "box" style =" width: 600px; height: auto; border: 2px solid white; background: transparent; margin: auto;">
    <form action="/sign-in" method="post">
        <p style = "font-size: 30px; margin-left: 9%"> Username <input type="text" name="username" style = "margin-left: 20px; width: 300px; height: 30px"></input></p>
        <p style = "font-size: 30px; margin-left: 10%"> Password <input type="text" name="password" style = "margin-left: 20px; width: 300px; height: 30px"></input></p>
        
        
        <button class="page-action" type="submit" style = "margin-left: 37%"> SIGN IN </button>
    </form>
    
    <p style = "margin-top: 10px; text-align: center" >
        Don't have an account? 
        <a href="/sign-up" style ="color: #510071">Sign Up</a> 
    </p>
    
    </div>
</div>

{% endblock %}