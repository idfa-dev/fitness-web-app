{% extends "base.peb" %}

{% block title %}Home{% endblock %}

{% block header %}
<div style="text-align: center">
    <img src="/static/images/jympal_logo.png" alt="Jympal logo" style = "width: 20%;" >
    <header style="margin:0px"> You wanna be fit, Gymit! </header>
</div>
{% endblock %}  

{% block content %}

<p style="text-align: center"> Recent Activity: </p>
<div style="display: flex; justify-content: center; gap: 20px;">
    <div class="box" style =" width: 200px; height: auto; border: 2px solid white; background: transparent">
    workout image box placeholder kinda thing
    </div>
    
    <div class="box" style =" width: 200px; height: auto; order: 2px transparent; background: transparent">
    
    <p> Workout/Exercise: [ Name ] </p>
    <p style = "margin-top: 2%"> Workout Time: </p>
    <p style = "margin-top: 2%"> Calories Burnt: </p>

    </div>
</div>


{% endblock %}