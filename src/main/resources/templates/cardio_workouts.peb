{% extends "base.peb" %}

{% block title %}Cardio Workouts{% endblock %}

{% block header %}

<div class="center">
    <h1><span style="color: #E32141">CARDIO</span> WORKOUTS</h1>
</div>
{% for workout in workouts %}
    <div class="workout-container">
        <p><b> {{ workout['name'] }} </b></p>
        <p style="font-size: 16px;"><em> {{ workout['desc'] }} </em></p>
    </div>
{% endfor %}
{% endblock %}